static func build(active: Array, reaction: Array) -> Dictionary:
	var a := active.duplicate(true)
	var r := reaction.duplicate(true)
	while a.size() < 4: a.append(["留空", "无", "无"])
	while r.size() < 4: r.append(["留空", "无", "无"])
	return {"active": a, "reaction": r}

