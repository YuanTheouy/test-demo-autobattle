config_version=5

[application]
config/name="AutoBattle — 双人对抗"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=1400
window/size/viewport_height=830
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.05, 0.075, 1)
